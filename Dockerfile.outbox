# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/outbox-worker ./cmd/outbox-worker
FROM alpine:3.24
RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S gohub && adduser -S -G gohub gohub
COPY --from=builder /out/outbox-worker /app/outbox-worker
USER gohub
ENTRYPOINT ["/app/outbox-worker"]